# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME_CHAT=deepseek-chat

# Embedding 模型路径（本地 BGE 模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Rerank 模型路径（本地 Cross-Encoder）
RERANK_MODEL=BAAI/bge-reranker-base

# ---- 企业化第二阶段：认证授权 ----
# 鉴权总开关（false 时所有鉴权逻辑完全旁路，回到旧行为）
AUTH_ENABLED=true
# 开发模式：true 时启用 POST /auth/token 本地签发端点（生产必须 false）
AUTH_DEV_MODE=false
# JWT 校验密钥（HS256；接企业 SSO 时切 RS256+JWKS，见 auth/jwt_tokens.py）
JWT_SECRET=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
# 开发签发 token 有效期（分钟）
JWT_EXPIRE_MINUTES=120
