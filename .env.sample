# DeepSeek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL_NAME_CHAT=deepseek-chat

# Embedding 模型路径（本地 BGE 模型）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# Rerank 模型路径（本地 Cross-Encoder）
RERANK_MODEL=BAAI/bge-reranker-base

# ---- 企业化第二阶段：认证授权 ----
# 鉴权总开关（false 时所有鉴权逻辑完全旁路，回到旧行为）
AUTH_ENABLED=true
# 开发模式：true 时启用 POST /auth/token 本地签发端点（生产必须 false）
AUTH_DEV_MODE=false
# JWT 校验密钥（HS256；接企业 SSO 时切 RS256+JWKS，见 auth/jwt_tokens.py）
JWT_SECRET=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
# 开发签发 token 有效期（分钟）
JWT_EXPIRE_MINUTES=120

# ---- 企业化第二阶段（续）：推理服务化（TEI）----
# 推理后端：local（进程内加载 BGE，默认）/ tei（独立 TEI 推理服务）
EMBEDDING_BACKEND=local
# tei 模式必填：TEI 服务根地址（compose 内网示例 http://tei-embedding:80）
TEI_EMBEDDING_URL=
TEI_RERANKER_URL=

# ---- 企业化第二阶段（续）：OpenTelemetry 链路追踪 ----
# OTLP HTTP endpoint（如 http://otel-collector:4318）；空则追踪静默降级
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hr-agent
