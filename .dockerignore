# 版本库与本地状态
.git/
.gitignore

# 数据库文件（容器内首次启动自动生成 employees.db）
db/
*.db
*.db-shm
*.db-wal

# 本地模型缓存（经挂载卷注入，不打进镜像/上下文）
.local_models/
.cache/

# Python 产物
__pycache__/
*.py[cod]
.pytest_cache/

# 评测报告与临时产物（容器运行时不需要）
eval/report.json
eval/weight_sweep_result.json
logs/
*.log

# 环境变量与 IDE
.env
.idea/
.vscode/

# 仅在宿主机使用的辅助脚本（评测、预下载 wheel），不需要进镜像
scripts/
eval/

# 容器化调试留下的临时脚本与输出
_*.py
_*.txt
_*.log

# 说明：build_wheels/ 刻意不排除 —— Dockerfile 用
# RUN --mount=type=bind,source=build_wheels 从构建上下文读取它做离线安装。
# 该目录以只读 bind mount 挂载，不会写进镜像层。
